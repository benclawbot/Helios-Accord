{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helios Accord",
  "version": "1.0.0",
  "identifier": "com.benclawbot.heliosaccord",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Helios Accord",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "Grand strategy within one star",
    "longDescription": "Govern humanity across a living solar system in this single-system grand strategy game.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
